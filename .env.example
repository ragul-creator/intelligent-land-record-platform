# Application
APP_ENV=development
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# PostgreSQL/PostGIS - replace these development placeholders locally.
POSTGRES_DB=land_records
POSTGRES_USER=replace_with_local_db_user
POSTGRES_PASSWORD=replace_with_local_db_password

# MinIO - replace these development placeholders locally.
MINIO_ROOT_USER=replace_with_local_minio_user
MINIO_ROOT_PASSWORD=replace_with_local_minio_password
MINIO_API_HOST_PORT=9001
MINIO_CONSOLE_HOST_PORT=9002

# Backend object storage and asynchronous worker configuration.
# The Docker services use MinIO at http://minio:9000, not localhost.
S3_BUCKET=land-records
S3_REGION=us-east-1
SIGNED_URL_EXPIRY_SECONDS=900
REDIS_URL=redis://redis:6379/0

# Authentication - generate a unique, high-entropy value locally. Never commit it.
AUTH_JWT_SECRET=replace_with_a_long_random_local_jwt_secret
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_LIFETIME_SECONDS=900
AUTH_REFRESH_TOKEN_LIFETIME_SECONDS=604800

# One-time local bootstrap only. Leave blank until creating the first ADMIN.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=Development Administrator
BOOTSTRAP_ADMIN_LOGIN_ID=
